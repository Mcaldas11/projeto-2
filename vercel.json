{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "back-end": {
      "root": "Back-End",
      "framework": "express",
      "entrypoint": "src/server.js"
    },
    "front-end": {
      "root": "Front-End/front-end",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "back-end" } },
    { "source": "/(.*)", "destination": { "service": "front-end" } }
  ]
}
