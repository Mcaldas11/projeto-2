# Server configuration 
PORT=port
HOST=host
# Database connection
DB_HOST=db_host
DB_PORT=3306
DB_USER=db_user
DB_PASSWORD=db_password
DB_NAME=db_name
DB_DIALECT='mysql'
DB_SYNC=false
DB_SYNC_FORCE=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret